{% assign lab_members = '' | split: '' %}
{% for member in site.data.people.advisor %}
  {% assign lab_members = lab_members | push: member.name %}
{% endfor %}
{% for member in site.data.people.students %}
  {% assign lab_members = lab_members | push: member.name %}
{% endfor %}
{% for member in site.data.people.alumni %}
  {% assign lab_members = lab_members | push: member.name %}
{% endfor %}

<div class="selected-pubs-toolbar">
  <div class="selected-pubs-filters" role="group" aria-label="Filter selected publications">
    <span class="selected-pubs-filter-label" id="pub-filter-label">filter</span>
    <button type="button" class="filter-chip active" data-pub-filter="all" aria-pressed="true">all</button>
    <button type="button" class="filter-chip" data-pub-filter="chi" aria-pressed="false">CHI</button>
    <button type="button" class="filter-chip" data-pub-filter="usenix" aria-pressed="false">USENIX Security</button>
    <button type="button" class="filter-chip" data-pub-filter="cscw" aria-pressed="false">CSCW</button>
    <button type="button" class="filter-chip" data-pub-filter="awarded" aria-pressed="false">🏆 award-winning</button>
  </div>
  <div class="selected-pubs-search">
    <label for="selectedPubSearch" class="selected-pubs-search-label">search publications</label>
    <input type="search" id="selectedPubSearch" placeholder="title, author, venue…" autocomplete="off">
  </div>
</div>

<div class="publications" id="selected-publications-list">
  {% assign awarded_publications = site.data.publications | where_exp: 'item', 'item.awards.size > 0' %}
  {% assign sorted_awarded_publications = awarded_publications | sort: 'year' | reverse %}

  {% assign counter = 0 %}
  {% for publication in sorted_awarded_publications %}
    {% if counter < 5 %}
      {% assign venue_key = 'other' %}
      {% if publication.venue contains 'CHI PLAY' %}
        {% assign venue_key = 'other' %}
      {% elsif publication.venue contains 'CHI' %}
        {% assign venue_key = 'chi' %}
      {% elsif publication.venue contains 'USENIX' %}
        {% assign venue_key = 'usenix' %}
      {% elsif publication.venue contains 'CSCW' or publication.venue contains 'Computer-Supported' %}
        {% assign venue_key = 'cscw' %}
      {% endif %}
      <div class="publication" data-venue="{{ venue_key }}" data-awarded="{% if publication.awards.size > 0 %}true{% else %}false{% endif %}">
        <div class="publication-title">
          {{ publication.title }}
        </div>
        <div class="publication-authors">
          {% for author in publication.authors %}
            {% if lab_members contains author.name %}
              <strong class="lab-member">{{ author.name }}</strong>
              {%- unless forloop.last %},{% endunless %}
            {% elsif author.self %}
              <strong>{{ author.name }}</strong>
              {%- unless forloop.last %},{% endunless %}
            {% else %}
              {{ author.name -}}
              {%- unless forloop.last %},{% endunless %}
            {% endif %}
          {% endfor %}
        </div>
        <div class="publication-venue">
          {{ publication.venue }}
        </div>
        <div class="publication-awards">
          {% for award in publication.awards %}
            <span class="award"> 🏆 {{ award.body }}</span>
          {% endfor %}
        </div>
        {% include publication_actions.liquid publication=publication %}
      </div>
      {% assign counter = counter | plus: 1 %}
    {% else %}
      {% break %}
    {% endif %}
  {% endfor %}
  <p class="pubs-empty-state" id="selected-pubs-empty" hidden>No publications match — try clearing the search or filters.</p>
</div>

<a class="see-all-link" href="{{ '/publications/' | relative_url }}">view all publications <i class="ti ti-arrow-right" aria-hidden="true"></i></a>
