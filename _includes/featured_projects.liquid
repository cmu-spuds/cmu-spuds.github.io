{% assign flagship_projects = site.data.featured_projects | where: 'flagship', true %}
{% assign more_projects = site.data.featured_projects | where_exp: 'p', 'p.flagship != true' %}

<div class="flagship-projects">
  {% for project in flagship_projects %}
    <a class="flagship-project-card" href="{{ project.url }}" target="_blank" rel="noopener noreferrer">
      <h3 class="flagship-project-title">{{ project.title }}</h3>
      {% if project.award %}
        <span class="award">🏆 {{ project.award }}</span>
      {% endif %}
      {% if project.paper %}
        <p class="flagship-project-paper">{{ project.paper }}</p>
      {% endif %}
      {% if project.venue %}
        <p class="flagship-project-venue">{{ project.venue }}</p>
      {% endif %}
      <span class="see-project">see project <i class="ti ti-arrow-right" aria-hidden="true"></i></span>
    </a>
  {% endfor %}
</div>

<div class="more-projects">
  {% for project in more_projects %}
    <a class="more-project-card" href="{{ project.url }}" target="_blank" rel="noopener noreferrer">
      <h3 class="more-project-title">{{ project.title }}</h3>
      <span class="see-project">see project <i class="ti ti-arrow-right" aria-hidden="true"></i></span>
    </a>
  {% endfor %}
</div>
