<div style="display: flex; flex-wrap: nowrap; gap: 1rem; overflow-x: auto; padding: 0.5rem 0;">
  {% for project in site.data.featured_projects %}
    <a href="{{ project.url }}" target="_blank" style="display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; min-width: 180px; padding: 0.75rem 1.25rem; border: 1px solid var(--global-theme-color); border-radius: 6px; text-decoration: none; transition: all 0.2s ease; background-color: transparent; color: var(--global-theme-color); font-weight: 500; font-size: 0.9rem; white-space: nowrap;">
      {{ project.title }}
    </a>
  {% endfor %}
</div>
